{
  "name": "triage-service",
  "version": "0.1.0",
  "description": "Issue Intake & Triage Service — Node.js companion macroservice",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.4.0",
    "@octokit/rest": "^21.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.4.0",
    "knex": "^3.1.0",
    "koa": "^3.1.2",
    "koa-bodyparser": "^4.4.0",
    "koa-ratelimit": "^6.0.0",
    "koa-static": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.0",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/koa-static": "^4.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
